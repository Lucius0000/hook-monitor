{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON_EXE> <USERPROFILE>/.codex/hooks-monitor/codex_hooks_monitor/hook_logger.py --runtime-root <USERPROFILE>/.codex/hooks-monitor",
            "commandWindows": "<PYTHON_EXE> <USERPROFILE>\\.codex\\hooks-monitor\\codex_hooks_monitor\\hook_logger.py --runtime-root <USERPROFILE>\\.codex\\hooks-monitor",
            "timeout": 30,
            "statusMessage": "Hooks Monitor event logging"
          }
        ]
      }
    ]
  }
}
